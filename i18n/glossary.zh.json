  "banned": [
    {
      "text": "保录",
      "re": "(?<![不无])保录|包过|不录全退|保1录1",
      "why": "admission guarantees: banned in Chinese education advertising (广告法 第二十四条) and a fraud signal"
    },
    {
      "text": "定向录取/内部渠道",
      "re": "定向录取|内部渠道|特殊渠道|内推名额|捐赠名额",
      "why": "named by courts and media as fraud signals"
    },
    {
      "text": "成功率",
      "re": "成功率",
      "unlessSource": "성공률|success rate",
      "why": "unsourced success rates are invented statistics"
    },
    {
      "text": "斩获/顶级/国家级",
      "re": "斩获|顶级|国家级",
      "why": "ad-law superlatives and agency boasting"
    },
    {
      "text": "互联网黑话",
      "re": "赋能|助力|打造|闭环|抓手|底层逻辑|赛道|颗粒度|拉通",
      "why": "business jargon read as AI or agency copy; use a concrete verb"
    },
    {
      "text": "拔高词",
      "re": "无缝|全方位|至关重要|深入探讨",
      "why": "inflation words; say which steps are covered"
    },
    {
      "text": "AI 口头禅",
      "re": "值得注意的是|值得一提的是|总而言之|综上所述|众所周知|不可否认",
      "why": "empty openers and closers; state the point"
    },
    {
      "text": "宏大开头",
      "re": "时代背景|随着.{0,12}不断发展|在当今",
      "why": "grand opener that carries no information"
    },
    {
      "text": "口号",
      "re": "让我们|之旅|扬帆|起航|拭目以待",
      "why": "slogan or pep-talk phrasing"
    },
    {
      "text": "圆梦/名校直通车",
      "re": "圆梦|梦校|直通车|起跑线|直达名校",
      "why": "implies a promised outcome"
    },
    {
      "text": "尊享/高端",
      "re": "尊享|高端定制|精英|专属",
      "why": "luxury signalling"
    },
    {
      "text": "催促",
      "re": "名额有限|抓紧|立即抢|限时|马上咨询|立即预约",
      "why": "manufactured urgency"
    },
    {
      "text": "错误称呼",
      "re": "宝爸|宝妈|家长朋友们|小编|我司|您们|本公司|本机构",
      "why": "wrong register; use 家长, 您, 我们"
    },
    {
      "text": "量身定制",
      "re": "量身定制|量身打造",
      "unlessSource": "맞춤",
      "why": "every agency says it; say what is individual instead"
    }
  ],
  "avoid": [
    {
      "text": "！",
      "re": "[！!]",
      "max": 0,
      "why": "no exclamation marks in body text or headings"
    },
    {
      "text": "进行/作出/加以",
      "re": "进行|作出|做出|加以|给予",
      "max": 0,
      "why": "weak verb + noun; use the verb itself (进行面试 is acceptable)"
    },
    {
      "text": "相关/有关",
      "re": "相关|有关",
      "max": 0,
      "why": "name the thing instead"
    },
    {
      "text": "框架词",
      "re": "作为|对于|通过|基于|就.{1,8}而言|在.{1,10}方面",
      "max": 0,
      "why": "preposition shell; put the real subject first"
    },
    {
      "text": "关于",
      "re": "关于(?!我们)",
      "max": 0,
      "why": "preposition shell (关于我们 as a nav label is fine)"
    },
    {
      "text": "致力于/提供…服务",
      "re": "致力于|提供.{0,10}服务|为您提供",
      "max": 0,
      "why": "use the verb: 我们协助办理…"
    },
    {
      "text": "空洞形容词",
      "re": "专业(?:的|团队|顾问|服务|水准|能力)|优质|高效|贴心|资深|经验丰富|个性化|全面",
      "max": 0,
      "why": "empty praise; only with the fact behind it (专业 alone is fine: it also means a college major)"
    },
    {
      "text": "一站式",
      "re": "一站式",
      "max": 1,
      "why": "at most once per page, followed by what it means"
    },
    {
      "text": "能够/将会",
      "re": "能够|将会",
      "max": 0,
      "why": "能, 会"
    },
    {
      "text": "您",
      "re": "您",
      "max": 2,
      "why": "drop 您 where the sentence is clear without it"
    },
    {
      "text": "你",
      "re": "你(?!们)",
      "max": 0,
      "why": "address parents as 您 (你们 in a parent's FAQ question is fine)"
    },
    {
      "text": "名词+们",
      "re": "(?<![我你他她它咱])们",
      "max": 0,
      "why": "drop 们 when plurality is clear"
    },
    {
      "text": "被",
      "re": "被(?!录取|拒|退)",
      "max": 0,
      "why": "active voice, or 由 + agent; 被录取/被拒签 are fine"
    },
    {
      "text": "的的的",
      "re": "的[^，。；：？！的]{0,10}的[^，。；：？！的]{0,10}的",
      "max": 0,
      "why": "chain of three 的; restructure"
    },
    {
      "text": "一个",
      "re": "一个",
      "max": 0,
      "why": "usually padding (这是一个…的…)"
    },
    {
      "text": "不仅…更…",
      "re": "不仅.{1,20}更|不是.{1,20}而是",
      "max": 0,
      "why": "contrast frame; state the point directly unless the source contrasts two real things"
    },
    {
      "text": "长句",
      "re": "[^，。；：？！、（）“”\\n]{41,}",
      "max": 0,
      "why": "over 40 characters without a break; split"
    },
    {
      "text": "首先/其次/最后",
      "re": "首先|其次|此外|然而",
      "max": 0,
      "why": "logic words at every turn read as generated"
    }
  ]
}
